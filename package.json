{
  "name": "adadmin",
  "version": "1.0.0",
  "private": true,
  "description": "Satisfactory dedicated server management app",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @adadmin/backend --filter @adadmin/frontend dev",
    "build": "pnpm --filter @adadmin/backend build && pnpm --filter @adadmin/frontend build",
    "start": "pnpm --filter @adadmin/backend start",
    "lint": "biome check --write",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
