# Address and port the web app listens on. 0.0.0.0 makes it reachable from the LAN.
HOST=0.0.0.0
PORT=3000

# Optional. Only needed if the server runs without AllowInsecureLocalAccess=1.
# Generate one in the server console with: server.GenerateAPIToken
SATISFACTORY_API_TOKEN=

# Stop the server this many minutes after the last player leaves. 0 disables it.
IDLE_SHUTDOWN_MINUTES=2
